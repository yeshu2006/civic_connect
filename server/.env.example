# CivicConnect Server Environment Variables

# Port for backend API server
PORT=5000

# Node environment: development | production | test
NODE_ENV=development

# Allowed client URL(s) for CORS in production (e.g. https://your-app.vercel.app or comma-separated list or *)
CLIENT_URL=http://localhost:3000

# JSON Web Token Secret and Expiry
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# MongoDB connection string (Atlas URI or local/docker mongo)
# When omitted or empty, falls back to embedded MongoDB Memory Server
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>

# Cloudinary image storage (optional - falls back to local /uploads storage if omitted)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret
