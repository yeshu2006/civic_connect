# CivicConnect Client Environment Variables

# Backend API base URL. Use /api when proxied by Vite dev server or Express in production.
# When deploying frontend and backend to separate domains (e.g. Vercel + Render):
# Set VITE_API_BASE_URL to full backend api URL, e.g. https://your-backend.onrender.com/api
# Or set VITE_API_URL to https://your-backend.onrender.com
VITE_API_BASE_URL=/api
VITE_API_URL=
VITE_BACKEND_URL=
PORT=3000
