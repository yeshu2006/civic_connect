{
  "name": "civicconnect",
  "version": "1.0.0",
  "description": "CivicConnect – AI-Powered Civic Issue Reporting and Management Platform",
  "scripts": {
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "node run-dev.js",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "build:client": "npm --prefix client run build",
    "build": "npm --prefix client run build",
    "start": "node server/server.js",
    "reset-auth": "npm --prefix server run reset-auth",
    "clear-complaints": "npm --prefix server run clear-complaints",
    "test": "node --env-file=server/.env server/test-all-features.js"
  },
  "keywords": ["civic", "reporting", "mern", "ai", "puter", "vision", "leaflet"],
  "author": "CivicConnect Team",
  "license": "ISC"
}
